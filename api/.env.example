# This is the API token from https://www.themoviedb.org/settings/api
TMDB_TOKEN=your_token_here

# This is the database connection string for postgres. You can use a local database or a hosted one like Supabase.
# Example: postgres://postgres:postgres@localhost:5432/k-cinema-bot
DATABASE_URL=your_database_url_here

# This is the Redis connection string. Use "rediss://" (with TLS) for hosted providers like Upstash.
# If it's not set, the API connects to a local Redis without TLS.
# Example: rediss://default:your_password@your-db.upstash.io:6379
REDIS_URL=your_redis_url_here

# Twitch bot credentials, used for the !rec, !star and !setmovie commands and for the chat announcement
# when the current movie is set from the web. You can get the token from https://twitchtokengenerator.com/
BOT_USERNAME='username'
BOT_TOKEN='oauth:your_token_here'
# The bot joins every channel registered in K-Cinema (Channels table).
# Set to false to keep the bot disconnected (e.g. in development, to avoid two bots answering)
TWITCH_BOT_ENABLED=true

# Original channel: existing Stars/CurrentMovies without a channel are assigned to it on startup.
# LEGACY_CHANNEL_ID is the channel's Twitch user ID.
LEGACY_CHANNEL=your_channel
LEGACY_CHANNEL_ID=123456789
