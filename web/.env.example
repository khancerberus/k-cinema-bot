# Public URL of the API (e.g. https://your-api.onrender.com). In development it's not needed: Vite proxies /api to localhost:4000
VITE_API_URL=https://your-api.example.com
# Subpath where the web is served, only if it isn't served at the root of the domain, e.g. /k-cinema/
# VITE_BASE_PATH=/k-cinema/
